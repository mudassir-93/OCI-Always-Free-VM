[Unit]
Description=OCI Always Free A1 capacity monitor (read-only by default)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
# Replace CHANGE_ME with the Linux account name and matching home directory.
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/oci-free-instance-automation
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/oci-free-watch.env
UMask=0077
ExecStart=/home/CHANGE_ME/oci-free-instance-automation/.venv/bin/python /home/CHANGE_ME/oci-free-instance-automation/oci_free_watch.py --monitor
Restart=on-failure
RestartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/CHANGE_ME/oci-free-instance-automation/logs /home/CHANGE_ME/oci-free-instance-automation/state

[Install]
WantedBy=multi-user.target
